/* Current Batch */
QWidget#batchContainer {
    background-color: #F5F8FC;
    border: 1px solid #DCE5F0;
    border-radius: 8px;
}

QLabel#batchTitle {
    color: #17365D;
    font-size: 13px;
    font-weight: 600;
}

QLabel#batchSubtitle {
    color: #718096;
    font-size: 10px;
}

/* Batch count labels */
QLabel#batchCountLabel {
    color: #17365D;
    font-size: 11px;
    font-weight: 600;
    padding: 0 6px;
}

/* Batch action buttons */
QPushButton#batchActionButton {
    background-color: #FFFFFF;
    color: #2563EB;
    border: 1px solid #D6E2F1;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 10px;
    font-weight: 500;
}

QPushButton#batchActionButton:hover {
    background-color: #EFF6FF;
    border-color: #2563EB;
}

/* Batch separators */
QFrame#batchSeparator {
    color: #DCE5F0;
    background-color: #DCE5F0;
    border: none;
    max-width: 1px;
}

/* Primary toolbar buttons */
QPushButton#primaryToolbarButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: 1px solid #2563EB;
    border-radius: 5px;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#primaryToolbarButton:hover {
    background-color: #1D4ED8;
    border-color: #1D4ED8;
}

/* Clear Batch button */
QPushButton#dangerToolbarButton {
    background-color: #FFFFFF;
    color: #DC2626;
    border: 1px solid #FECACA;
    border-radius: 5px;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#dangerToolbarButton:hover {
    background-color: #FEF2F2;
    border-color: #DC2626;
}

/* Metadata table */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    color: #17365D;
    border: 1px solid #DCE5F0;
    gridline-color: #E8EEF5;
    selection-background-color: #DBEAFE;
    selection-color: #17365D;
}

QHeaderView::section {
    background-color: #F1F5F9;
    color: #17365D;
    border: none;
    border-bottom: 1px solid #DCE5F0;
    padding: 8px 6px;
    font-size: 11px;
    font-weight: 600;
}

/* Footer labels */
QLabel#footerLabel {
    color: #64748B;
    font-size: 10px;
    padding: 4px;
}

/* Pagination buttons */
QPushButton#pageButton {
    background-color: #FFFFFF;
    color: #475569;
    border: 1px solid #DCE5F0;
    border-radius: 5px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    font-size: 11px;
}

QPushButton#pageButton:hover {
    background-color: #EFF6FF;
    border-color: #2563EB;
    color: #2563EB;
}

/* Current page */
QPushButton#currentPageButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: 1px solid #2563EB;
    border-radius: 5px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    font-size: 11px;
    font-weight: 600;
}