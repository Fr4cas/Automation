QMainWindow {
    background-color: #F5F7FA;
    color: #1E293B;
}

QFrame#inputCard,
QFrame#progressCard,
QFrame#resultsCard,
QFrame#logCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

QFrame#successBlock {
    background-color: #ECFDF5;
    border: 1px solid #A7F3D0;
    border-radius: 8px;
}

QFrame#failedBlock {
    background-color: #FEF2F2;
    border: 1px solid #FECACA;
    border-radius: 8px;
}

QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 9px 18px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #1D4ED8;
}

QLineEdit {
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 9px 12px;
    selection-background-color: #2563EB;
}

QLineEdit:focus {
    border: 1px solid #2563EB;
}

QPushButton#startButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 12px 20px;
    font-size: 11pt;
    font-weight: 600;
}

QPushButton#startButton:hover {
    background-color: #1D4ED8;
}

QPushButton#startButton:disabled {
    background-color: #CBD5E1;
    color: #64748B;
}

QLabel {
    color: #1E293B;
}

QLabel#successTitle,
QLabel#failedTitle {
    font-size: 10pt;
    font-weight: 600;
}

QLabel#successNumber {
    color: #059669;
    font-size: 24pt;
    font-weight: 700;
}

QLabel#failedNumber {
    color: #DC2626;
    font-size: 24pt;
    font-weight: 700;
}

QTextEdit {
    background-color: #F5F7FA;
    color: #334155;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 12px;
    selection-background-color: #2563EB;
}

QPushButton#secondaryButton {
    background-color: #FFFFFF;
    color: #2563EB;
    border: 1px solid #BFDBFE;
    border-radius: 6px;
    padding: 9px 18px;
    font-weight: 600;
}

QPushButton#secondaryButton:hover {
    background-color: #EFF6FF;
    border: 1px solid #93C5FD;
}

QPushButton#secondaryButton:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
    border: 1px solid #E2E8F0;
}